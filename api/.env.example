# 本地开发环境配置模板（占位值，不含真实密钥）
# 使用方式：复制为 .env 后按本机环境填写；.env 已被 .gitignore 忽略，禁止提交
# ---------------------------------------------------------------------------
# MinIO 对象存储
# 端口说明：若宿主机 ::1:9000 被 wslrelay 占用导致 9000 转发失败，可把容器映射到 19000
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=<your-access-key>
MINIO_SECRET_KEY=<your-secret-key>
MINIO_SECURE=false
MINIO_REGION=us-east-1

# PostgreSQL / PostGIS
# PG_DSN 优先；未设置时回退到 PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD
PG_DSN=postgresql://<user>:<password>@<host>:<port>/<dbname>
PGHOST=localhost
PGPORT=5432
PGDATABASE=rs_change
PGUSER=<your-pg-user>
PGPASSWORD=<your-pg-password>
